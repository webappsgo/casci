{{/* Admin Settings */}}
{{define "content"}}
<div class="admin-settings">
    <div class="settings-header">
        <h1>Settings</h1>
        <p class="form-help">
            These are the values this instance is currently running with, read
            from <code>server.yml</code> and the documented environment
            variables. Saving from the panel is not wired up yet, so change
            them in <code>server.yml</code> and restart.
        </p>
    </div>

    <div class="settings-tabs">
        <button class="tab-btn active" data-tab="server">Server</button>
        <button class="tab-btn" data-tab="web">Web</button>
        <button class="tab-btn" data-tab="ssl">SSL/TLS</button>
        <button class="tab-btn" data-tab="database">Database</button>
    </div>

    <form id="settings-form" class="settings-form">
        {{/* Server Settings Tab */}}
        <div class="tab-content active" data-tab="server">
            <h2>Server Settings</h2>

            <div class="form-group">
                <label for="server-title">Application Title</label>
                <input type="text" id="server-title" name="server.branding.title" value="{{.Config.Server.Title}}" class="form-control" readonly>
            </div>

            <div class="form-group">
                <label for="server-tagline">Tagline</label>
                <input type="text" id="server-tagline" name="server.branding.tagline" value="{{.Config.Server.Tagline}}" class="form-control" readonly>
            </div>

            <div class="form-group">
                <label for="server-fqdn">FQDN</label>
                <input type="text" id="server-fqdn" name="server.fqdn" value="{{.Config.Server.FQDN}}" class="form-control" readonly>
                <small class="form-help">Fully qualified domain name for this server</small>
            </div>

            <div class="form-group">
                <label for="server-port">Port</label>
                <input type="number" id="server-port" name="server.port" value="{{.Config.Server.Port}}" class="form-control" readonly>
            </div>

            <div class="form-group">
                <label for="server-address">Listen Address</label>
                <input type="text" id="server-address" name="server.address" value="{{.Config.Server.Address}}" class="form-control" readonly>
                <small class="form-help">"[::]" binds every IPv4 and IPv6 interface; "127.0.0.1" is localhost only</small>
            </div>

            <div class="form-group">
                <label for="server-mode">Mode</label>
                <input type="text" id="server-mode" name="server.mode" value="{{.Config.Server.Mode}}" class="form-control" readonly>
                <small class="form-help">"production" or "development"</small>
            </div>

            <div class="form-group">
                <label for="server-admin-path">Admin Path</label>
                <input type="text" id="server-admin-path" name="server.admin_path" value="{{.Config.Server.AdminPath}}" class="form-control" readonly>
                <small class="form-help">The admin panel is mounted at /server/{{.Config.Server.AdminPath}}</small>
            </div>

            <div class="form-group">
                <label for="server-api-version">API Version</label>
                <input type="text" id="server-api-version" name="server.api_version" value="{{.Config.Server.APIVersion}}" class="form-control" readonly>
                <small class="form-help">The version segment of every /api/ route</small>
            </div>
        </div>

        {{/* Web Settings Tab */}}
        <div class="tab-content" data-tab="web">
            <h2>Web Settings</h2>

            <div class="form-group">
                <label for="web-cors">CORS Origins</label>
                <input type="text" id="web-cors" name="web.cors" value="{{.Config.Web.CORS}}" class="form-control" readonly>
                <small class="form-help">A single origin, a comma-separated list, or "*" for any origin</small>
            </div>

            <div class="form-group">
                <label>
                    <input type="checkbox" name="server.footer.cookie_consent" {{if .Config.Web.CookieConsentEnabled}}checked{{end}} disabled>
                    Show the cookie consent banner
                </label>
            </div>
        </div>

        {{/* SSL/TLS Tab */}}
        <div class="tab-content" data-tab="ssl">
            <h2>SSL/TLS</h2>

            <div class="form-group">
                <label>
                    <input type="checkbox" name="server.ssl.enabled" {{if .Config.Server.SSL.Enabled}}checked{{end}} disabled>
                    TLS enabled
                </label>
            </div>

            <div class="form-group">
                <label for="ssl-min-version">Minimum TLS Version</label>
                <input type="text" id="ssl-min-version" name="server.ssl.min_version" value="{{.Config.Server.SSL.MinVersion}}" class="form-control" readonly>
                <small class="form-help">TLS 1.2 is the floor; only "TLS1.3" raises it</small>
            </div>
        </div>

        {{/* Database Settings Tab */}}
        <div class="tab-content" data-tab="database">
            <h2>Database</h2>

            <div class="form-group">
                <label for="db-driver">Driver</label>
                <input type="text" id="db-driver" name="server.database.driver" value="{{.Config.Server.Database.Driver}}" class="form-control" readonly>
            </div>

            <div class="form-group">
                <label for="db-max-conns">Max Connections</label>
                <input type="number" id="db-max-conns" name="server.database.max_conns" value="{{.Config.Server.Database.MaxConns}}" class="form-control" readonly>
            </div>

            <div class="form-group">
                <label for="db-max-idle">Max Idle Connections</label>
                <input type="number" id="db-max-idle" name="server.database.max_idle_conn" value="{{.Config.Server.Database.MaxIdleConn}}" class="form-control" readonly>
            </div>

            <p class="form-help">
                The connection string is not shown here — it carries credentials.
            </p>
        </div>
    </form>
</div>
{{end}}
