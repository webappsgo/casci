{{/* Admin Layout - Used by admin panel pages */}}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    {{template "head" .}}
</head>
<body class="admin-panel">
    {{template "header" .}}
    {{template "nav" .}}

    <div class="admin-layout">
        <aside class="admin-sidebar">
            {{/* Only routes that are actually mounted are linked. The remaining
                 admin sections listed in AI.md PART 11/17/21 are tracked in
                 TODO.AI.md and get their nav entry when their handler exists. */}}
            <nav class="admin-nav">
                <a href="/server/{{.AdminPath}}" class="admin-nav-item {{if eq .Active "dashboard"}}active{{end}}">
                    <span class="icon">📊</span> Dashboard
                </a>
                <a href="/server/{{.AdminPath}}/config/settings" class="admin-nav-item {{if eq .Active "settings"}}active{{end}}">
                    <span class="icon">⚙️</span> Settings
                </a>
            </nav>
        </aside>

        <main class="admin-content">
            {{template "content" .}}
        </main>
    </div>

    {{template "footer" .}}
    {{template "scripts" .}}
</body>
</html>
