{{define "head"}}
{{/* MANDATORY PARTIAL - head.tmpl - <head> contents */}}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{if .Title}}{{.Title}} - {{end}}{{.SiteName}}</title>
<meta name="description" content="{{.Tagline}}">

{{/* Route prefixes the operator can rename. Published here so the static
     scripts never hardcode /api/v1 or /server/administration. */}}
<meta name="api-version" content="{{.APIVersion}}">
<meta name="admin-path" content="{{.AdminPath}}">

{{/* Favicon */}}
<link rel="icon" type="image/x-icon" href="/static/images/favicon.ico">

{{/* Stylesheets */}}
<link rel="stylesheet" href="/static/css/dracula.css" id="theme-dark">
<link rel="stylesheet" href="/static/css/light.css" id="theme-light" disabled>
<link rel="stylesheet" href="/static/css/styles.css">
{{end}}
